# =====================================================================
# Meu Treino - variaveis de ambiente
# Copie para .env (o docker-compose le automaticamente) e ajuste se quiser.
# =====================================================================

# --------------------------------- banco -----------------------------
POSTGRES_DB=meu_treino
POSTGRES_USER=meutreino
POSTGRES_PASSWORD=meutreino
# porta exposta no host (5432 costuma estar ocupada)
DB_PORT=5433

# ---------------------------------- api ------------------------------
API_PORT=8080
# troque em qualquer ambiente que nao seja o seu notebook
JWT_SECRET=troque-esta-chave-em-producao-meu-treino-2026-super-secreta-1234567890
JWT_EXPIRATION_DAYS=60
CORS_ALLOWED_ORIGINS=*

# ---------------------------------- web ------------------------------
WEB_PORT=8081

# --------------------------------- wger ------------------------------
# O catalogo completo (834 exercicios) ja vem no banco via migration.
# O sync so roda automaticamente se o banco estiver vazio.
WGER_BASE_URL=https://wger.de/api/v2
WGER_SYNC_ON_STARTUP=true
WGER_MAX_EXERCISES=2000
